{
  "name": "ai-and-ai-tools-compendium",
  "version": "1.0.0",
  "private": true,
  "description": "A reusable Ukrainian and English AI field guide",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/clean.mjs && eleventy --serve --port=8080",
    "build": "node scripts/clean.mjs && eleventy",
    "build:uk": "node scripts/build.mjs --language uk",
    "build:en": "node scripts/build.mjs --language en",
    "build:edition": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run build && npm test",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "gpt-tokenizer": "4.0.3",
    "playwright-core": "1.56.1"
  }
}
