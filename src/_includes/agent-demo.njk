<section id="agent-demo" class="reading-section agent-demo">
  <p class="eyebrow">CLAUDE CODE / PROJECT WALKTHROUGH</p>
  <h2>{{ t.agentTitle }}</h2>
  <p>{{ t.agentIntro }}</p>
  <p class="note">{{ t.agentDemoNotice }}</p>
  <ol class="agent-pipeline" aria-label="{{ t.agentTitle }}">
    {% for stage in t.agentStages %}<li><button type="button" data-agent-stage="{{ loop.index0 }}" aria-pressed="{{ 'true' if loop.first else 'false' }}" hidden><span>{{ loop.index | pad }}</span>{{ stage }}</button><noscript>{{ loop.index | pad }} · {{ stage }}</noscript></li>{% endfor %}
  </ol>
  <div class="agent-workspace">
    <aside class="agent-file-tree"><p class="eyebrow">AI-TOOLKIT /</p>{% for file in t.agentFiles %}<div><code>{{ file.name }}</code><small>{{ file.description }}</small></div>{% endfor %}<a class="text-link" href="{{ 'assets/materials/claude-code-practice.zip' | url }}" download>{{ t.agentDownload }} ↓</a></aside>
    <div class="agent-screen">
      <div class="agent-screen-heading"><span class="eyebrow">app.mjs</span><span class="pill" id="agent-mode">{{ t.before }}</span></div>
      {% for stage in t.agentStages %}<div data-agent-panel="{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}>
        <h3>{{ stage }}</h3><p>{{ t.agentStageIntro[loop.index0] }}</p>
        {% if loop.index0 == 0 %}<pre id="agent-before"><code>{{ view.agentDemo.before }}</code></pre>{% endif %}
        {% if loop.index0 == 1 %}<ol class="check-list">{% for item in t.agentPlan %}<li>{{ item }}</li>{% endfor %}</ol>{% endif %}
        {% if loop.index0 == 2 %}<div class="agent-diff"><p class="diff-removed">− {{ t.before }}</p><pre><code>{{ view.agentDemo.before }}</code></pre><p class="diff-added">+ {{ t.after }}</p><pre id="agent-after"><code>{{ view.agentDemo.after }}</code></pre></div>{% endif %}
        {% if loop.index0 == 3 %}<div class="agent-live-preview" id="agent-preview"><label for="agent-search">{{ t.agentQuery }}</label><input type="search" id="agent-search" value="Gemini" autocomplete="off"><p id="agent-result-count" role="status" aria-live="polite"></p><div id="agent-result-cards"></div><p id="agent-empty" hidden>{{ t.agentNoMatches }}</p></div>{% endif %}
        {% if loop.index0 == 4 %}<p class="agent-check-score" id="agent-check-score">{{ t.agentNotChecked }}</p><ul id="agent-checks" class="check-list" aria-live="polite"></ul>{% endif %}
      </div>{% endfor %}
    </div>
  </div>
  <div class="demo-controls" hidden><button type="button" class="button primary" id="agent-apply">{{ t.apply }}</button><button type="button" class="button" id="agent-validate">{{ t.validate }}</button><button type="button" class="text-button" id="agent-reset">{{ t.reset }}</button></div>
  <p id="agent-demo-status" role="status" aria-live="polite">{{ t.agentOriginal }}</p>
  <noscript><h3>{{ t.after }}</h3><pre><code>{{ view.agentDemo.after }}</code></pre><p>{{ t.agentNoJs }}</p></noscript>
</section>
<script id="agent-demo-data" type="application/json">{{ view.agentDemo.tools | jsonScript | safe }}</script>
