{% from "icons.njk" import arrow %}
{% macro contactIcon(kind) %}
<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {% if kind == 'website' %}
    <circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/>
  {% elif kind == 'telegram' %}
    <path fill="currentColor" stroke="none" d="M9.78 18.65 10.06 14.42 17.74 7.5c.34-.31-.07-.46-.52-.19L7.74 13.3l-4.1-1.28c-.88-.25-.89-.86.2-1.3L19.81 4.56c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71l-4.14-3.06-1.99 1.93c-.23.23-.42.42-.83.42Z"/>
  {% else %}
    <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
  {% endif %}
</svg>
{% endmacro %}
<nav class="footer-contacts" aria-labelledby="nix-contacts-title">
  <div class="footer-contacts-heading">
    <p class="eyebrow">КОНТАКТИ</p>
    <h2 id="nix-contacts-title">NIX у мережі</h2>
  </div>
  <ul class="contact-list">
    {% for contact in [
      { kind: 'website', name: 'Сайт NIX', handle: 'nixsolutions.com', url: 'https://www.nixsolutions.com/ua/' },
      { kind: 'telegram', name: 'Telegram', handle: '@nix_ukraine', url: 'https://t.me/nix_ukraine' },
      { kind: 'instagram', name: 'Instagram', handle: '@nix_ukraine', url: 'https://www.instagram.com/nix_ukraine?exln=MXFsOXNoMDIxaXIxNA==' }
    ] %}
    <li><a class="contact-card" href="{{ contact.url }}" target="_blank" rel="noopener noreferrer">
      <span class="contact-icon">{{ contactIcon(contact.kind) }}</span>
      <span class="contact-label"><strong>{{ contact.name }}</strong><span>{{ contact.handle }}</span></span>
      {{ arrow() }}
    </a></li>
    {% endfor %}
  </ul>
</nav>
