<section class="page-hero container"><p class="eyebrow">LEARNING BY DOING / 02</p><h1>{{ t.practiceHero }}</h1><p class="lede">{{ t.practiceIntro }}</p></section>
<div class="container reading-layout"><aside class="reading-sidebar"><nav class="contents-nav" aria-label="{{ t.pageContents }}"><p class="eyebrow">{{ t.pageContents }}</p>{% for exercise in view.exercises %}<a href="#{{ exercise.id }}">{{ loop.index | pad }} <span>{{ exercise.skill }}</span></a>{% endfor %}<a href="#agent-demo">+ <span>{{ t.agentTitle }}</span></a></nav><div class="progress-panel" hidden><strong>{{ t.progress }}</strong><progress value="0" max="{{ view.exercises | length }}" id="practice-progress"></progress><p id="progress-status" role="status"></p><p class="fineprint" id="storage-note">{{ t.storage }}</p><button type="button" class="text-button" id="reset-progress">{{ t.reset }}</button></div></aside>
<div class="reading-content">{% for exercise in view.exercises %}<article class="exercise reading-section" id="{{ exercise.id }}" data-exercise><div class="exercise-heading"><span class="eyebrow">{{ loop.index | pad }} / {{ exercise.tool }}</span><span class="pill">{{ exercise.minutes }}</span></div><h2>{{ exercise.title }}</h2><p class="lede small">{{ exercise.intro }}</p><div class="tool-chips">{% for tool in exercise.tools %}<a href="{{ tool.url }}" target="_blank" rel="noopener noreferrer">{{ t.openTool }} {{ tool.name }} {{ arrow() }}</a>{% endfor %}</div><h3>{{ t.steps }}</h3><ol class="steps">{% for step in exercise.steps %}<li>{{ step }}</li>{% endfor %}</ol>{% if exercise.materials %}<div class="materials">{% for material in exercise.materials %}<a class="text-link" href="{{ material.path | url }}" download>{{ material.label }} ↓</a>{% endfor %}</div>{% endif %}{% for prompt in exercise.prompts %}{% include 'prompt.njk' %}{% endfor %}<div class="note"><strong>{{ t.expected }}</strong><p>{{ exercise.result }}</p></div><h3>{{ t.checks }}</h3><ul class="check-list">{% for check in exercise.checks %}<li>{{ check }}</li>{% endfor %}</ul><details class="reflection"><summary>{{ t.reflect }}</summary><ul>{% for item in exercise.reflection %}<li>{{ item }}</li>{% endfor %}</ul></details><label class="complete-label" hidden><input type="checkbox" data-complete-exercise="{{ exercise.id }}">{{ t.done }}</label></article>{% endfor %}
<section id="agent-demo" class="reading-section agent-demo"><p class="eyebrow">EXTRA / HTML LAB</p><h2>{{ t.agentTitle }}</h2><p>{{ t.agentIntro }}</p><p class="note">h1 → <strong>{{ t.agentAfter }}</strong></p><div class="demo-grid"><div><h3>{{ t.before }}</h3><pre id="agent-before"><code>&lt;h1&gt;{{ t.agentBefore }}&lt;/h1&gt;
&lt;p&gt;{{ t.agentBody }}&lt;/p&gt;
&lt;button&gt;{{ t.agentButton }}&lt;/button&gt;</code></pre></div><div><h3>{{ t.after }}</h3><pre id="agent-after"><code>&lt;h1&gt;{{ t.agentAfter }}&lt;/h1&gt;
&lt;p&gt;{{ t.agentBody }}&lt;/p&gt;
&lt;button&gt;{{ t.agentButton }}&lt;/button&gt;</code></pre></div></div><div class="demo-controls" hidden><button type="button" class="button primary" id="agent-apply">{{ t.apply }}</button><button type="button" class="button" id="agent-validate" disabled>{{ t.validate }}</button><button type="button" class="text-button" id="agent-reset">{{ t.reset }}</button></div><iframe title="{{ t.example }}" sandbox="" id="agent-preview" hidden></iframe><ul id="agent-checks" class="check-list" aria-live="polite"></ul></section>
</div></div>
