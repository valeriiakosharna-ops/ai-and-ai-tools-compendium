<section class="page-hero container"><p class="eyebrow">FIELD NOTES / 01</p><h1>{{ t.toolHero }}</h1><p class="lede">{{ t.toolIntro }}</p><div class="anchor-links"><a href="#approaches">{{ t.approaches }} ↓</a><a href="#tools">{{ t.toolsTitle }} ↓</a><a href="#comparison">{{ t.comparison }} ↓</a></div></section>
<div class="container">
  <section class="section" id="approaches"><div class="section-heading"><h2>{{ t.approaches }}</h2><span class="pill">01 — 04</span></div><div class="approach-grid">{% for category in view.taxonomy.categories %}<article class="approach-card"><span class="eyebrow">{{ category.number }} / {{ category.tools }}</span><h3>{{ category.title }}</h3><p>{{ category.description }}</p><p class="analogy">{{ category.analogy }}</p><details><summary>{{ t.tryPrompt }}</summary><p>{{ category.example }}</p></details></article>{% endfor %}</div><p class="note">{{ t.approachNote }}</p></section>
  <section class="section" id="tools"><div class="section-heading"><h2>{{ t.toolsTitle }}</h2><span class="pill">{{ view.taxonomy.tools | length }}</span></div>
    <div class="tool-controls" hidden><div class="filters" role="group" aria-label="{{ t.taxonomy }}">{% for id in ['all','dialogue','research','coding'] %}<button type="button" data-filter="{{ id }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ t[id] }}</button>{% endfor %}</div><label class="search"><span class="sr-only">{{ t.searchLabel }}</span><span aria-hidden="true">⌕</span><input id="tool-search" type="search" placeholder="{{ t.search }}"></label></div><p class="sr-only" id="filter-status" role="status"></p>
    <div class="tools-grid">{% for tool in view.taxonomy.tools %}<article class="tool-card" id="{{ tool.id }}" data-category="{{ tool.category }}" data-search="{{ tool | searchText }}"><div class="card-top"><span class="tool-mark" aria-hidden="true"><img src="{{ tool.logo | url }}" width="28" height="28" alt=""></span><span class="eyebrow">{{ tool.maker }}</span></div><h3>{{ tool.name }}</h3><span class="tool-type">{{ tool.type }}</span><p>{{ tool.summary }}</p><details><summary>{{ t.more }}</summary><div class="tool-body"><p>{{ tool.description }}</p><p class="analogy">{{ tool.analogy }}</p><h4>{{ t.capabilities }}</h4><ul>{% for item in tool.capabilities %}<li>{{ item }}</li>{% endfor %}</ul><h4>{{ t.example }}</h4><p>{{ tool.example }}</p><div class="note"><strong>{{ t.remember }}</strong><p>{{ tool.limitation }}</p></div><h4>{{ t.official }}</h4><ul class="source-links">{% for link in tool.links %}<li><a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }} {{ arrow() }}</a></li>{% endfor %}</ul></div></details></article>{% endfor %}</div>
    <div class="empty-state" hidden><p>{{ t.empty }}</p><button class="button" type="button" id="reset-filters">{{ t.reset }}</button></div><p class="fineprint">{{ t.toolNote }}</p>
  </section>
  <section class="section" id="comparison"><h2>{{ t.comparison }}</h2><div class="table-scroll" tabindex="0" role="region" aria-label="{{ t.comparison }}"><table><thead><tr><th scope="col">{{ t.tool }}</th><th scope="col">{{ t.input }}</th><th scope="col">{{ t.output }}</th></tr></thead><tbody>{% for tool in view.taxonomy.tools %}<tr><th scope="row"><a href="#{{ tool.id }}" data-open-tool="{{ tool.id }}"><img class="tool-logo-inline" src="{{ tool.logo | url }}" width="18" height="18" alt="">{{ tool.name }} {{ arrow() }}</a></th><td>{{ tool.object }}</td><td>{{ tool.result }}</td></tr>{% endfor %}</tbody></table></div></section>
  <section class="section" id="choose"><h2>{{ t.choose }}</h2><p>{{ t.chooseText }}</p><div class="outcomes">{% for outcome in t.outcomes %}<article><span class="eyebrow">0{{ loop.index }}</span><h3>{{ outcome.title }}</h3><p>{{ outcome.text }}</p><div class="tool-chips">{% for tool in view.taxonomy.tools | categoryTools(outcome.category) %}<a href="#{{ tool.id }}" data-open-tool="{{ tool.id }}"><img class="tool-logo-inline" src="{{ tool.logo | url }}" width="18" height="18" alt="">{{ tool.name }} {{ arrow() }}</a>{% endfor %}</div></article>{% endfor %}</div></section>
</div>
