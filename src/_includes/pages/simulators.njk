<section class="page-hero container"><p class="eyebrow">UNDER THE HOOD / 03</p><h1>{{ t.labHero }}</h1><p class="lede">{{ t.labIntro }}</p><div class="anchor-links">{% for id in ['tokens','context','vectors','rag'] %}<a href="#{{ id }}">{{ t[id] }} ↓</a>{% endfor %}</div></section>
<div class="container lab-content">
  <section id="tokens" class="reading-section lab-panel"><p class="eyebrow">01 / TOKENISATION</p><h2>{{ t.tokens }}</h2><p>{{ t.tokenIntro }}</p><div class="lab-controls" data-token-controls hidden><label for="token-input">{{ t.tokenLabel }}</label><textarea id="token-input" rows="3" maxlength="5000">{{ t.tokenSample }}</textarea><button class="button primary" type="button" id="tokenize">{{ t.tokenize }}</button><p id="token-status" role="status" aria-live="polite"></p><div id="token-result" hidden><div class="token-numbers"><div><strong id="token-count"></strong><span>{{ t.tokenCount }}</span></div><div><strong id="character-count"></strong><span>{{ t.characters }}</span></div></div><ul id="token-pieces" class="token-pieces"></ul><pre id="token-roundtrip"></pre></div></div><p class="fineprint">{{ t.tokenCaveat }}</p><a href="https://platform.openai.com/tokenizer" target="_blank" rel="noopener noreferrer">OpenAI Tokenizer ↗</a></section>
  <section id="context" class="reading-section lab-panel"><p class="eyebrow">02 / CONTEXT WINDOW</p><h2>{{ t.context }}</h2><p>{{ t.contextIntro }}</p><div class="lab-controls" data-context-controls hidden><div class="range-grid"><label>{{ t.document }} <output id="document-value">2</output><input id="context-document" type="range" min="0" max="7" value="2"></label><label>{{ t.answer }} <output id="answer-value">4</output><input id="context-answer" type="range" min="1" max="5" value="4"></label></div><label class="checkbox-label"><input type="checkbox" id="context-summary">{{ t.summary }}</label><div class="context-desk" id="context-desk" aria-hidden="true"></div><p id="context-equation"></p><p id="context-status" role="status" aria-live="polite"></p></div><div class="note">{{ t.contextParts[0] }} + {{ t.contextParts[1] }} + {{ t.contextParts[2] }} + {{ t.contextParts[3] }} + {{ t.contextParts[4] }}</div></section>
  <section id="vectors" class="reading-section lab-panel"><p class="eyebrow">03 / RETRIEVAL</p><h2>{{ t.vectors }}</h2><p>{{ t.vectorIntro }}</p><div class="lab-controls" data-vector-controls hidden><label for="vector-query">{{ t.query }}</label><select id="vector-query">{% for query in view.lab.queries %}<option value="{{ query.id }}">{{ query.text }}</option>{% endfor %}</select><svg id="vector-map" viewBox="0 0 500 340" role="img" aria-labelledby="map-title"><title id="map-title">{{ t.nearest }}</title></svg><div class="demo-grid"><div><h3>{{ t.keywords }}</h3><ul id="keyword-results"></ul></div><div><h3>{{ t.nearest }}</h3><ol id="vector-results"></ol></div></div><p id="vector-status" role="status"></p></div><details><summary>{{ t.sourcesTitle }}</summary><ol>{% for doc in view.lab.documents %}<li><strong>{{ doc.title }}</strong><p>{{ doc.text }}</p></li>{% endfor %}</ol></details></section>
  <section id="rag" class="reading-section lab-panel"><p class="eyebrow">04 / RETRIEVAL-AUGMENTED GENERATION</p><h2>{{ t.rag }}</h2><p>{{ t.ragIntro }}</p><div class="lab-controls" data-rag-controls hidden><label for="rag-question">{{ t.query }}</label><select id="rag-question">{% for query in view.lab.ragQuestions %}<option value="{{ query.id }}">{{ query.text }}</option>{% endfor %}</select><div class="action-row"><button class="button primary" id="rag-retrieve" type="button">{{ t.retrieve }}</button><button class="button" id="rag-generate" type="button" disabled>{{ t.generate }}</button><button class="text-button" id="rag-reset" type="button">{{ t.reset }}</button></div><fieldset id="rag-selection" hidden><legend>{{ t.sourcesTitle }}</legend>{% for source in view.lab.ragSources %}<label><input type="checkbox" value="{{ source.id }}" data-rag-source>{{ source.id }} · {{ source.title }}</label>{% endfor %}</fieldset><pre id="rag-context" hidden></pre><div class="rag-answer note" id="rag-answer" hidden><h3>{{ t.ragResult }}</h3><div id="rag-paragraphs"></div><p id="rag-warning"></p><div id="rag-citations"></div></div><p id="rag-status" role="status" aria-live="polite"></p></div><div class="rag-source-list">{% for source in view.lab.ragSources %}<article id="source-{{ source.id }}"><span class="eyebrow">{{ source.id }}{% if source.archived %} / {{ t.archived }}{% endif %}</span><h3>{{ source.title }}</h3><p>{{ source.text }}</p></article>{% endfor %}</div></section>
  <section class="section"><h2>{{ t.labSources }}</h2><ul class="source-links"><li><a href="https://help.openai.com/en/articles/4936856-what-are-tokens-and-how-to-count-them" target="_blank" rel="noopener noreferrer">OpenAI · Tokens ↗</a></li><li><a href="https://developers.openai.com/api/docs/guides/embeddings" target="_blank" rel="noopener noreferrer">OpenAI · Embeddings ↗</a></li><li><a href="https://docs.cloud.google.com/architecture/gen-ai-rag-vertex-ai-vector-search?hl=en" target="_blank" rel="noopener noreferrer">Google Cloud · RAG ↗</a></li></ul></section>
</div>
